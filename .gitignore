*.elf
*.hex
*.bin

# ROS 2 / colcon workspaces (also covers Arduino CLI build/ folders)
build/
install/
log/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
