secrets.h
.env
.env.*
!.env.example

# Local tool metadata
.label.toml

# PlatformIO
.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

